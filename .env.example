# Copy to .env and fill in. Leave blank to keep a button in its "link not set" state.

# Social + resume
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_RESUME_URL=

# Contact form endpoint (Formspree-compatible, e.g. https://formspree.io/f/xxxxxxx)
# If blank, the form falls back to opening the visitor's email app addressed to you.
VITE_FORM_ENDPOINT=

# Project links (GitHub repo / live demo)
VITE_GUARDIAN_GITHUB=
VITE_GUARDIAN_DEMO=
VITE_CAREERFLOW_GITHUB=
VITE_ASSISTANT_GITHUB=
